DB_HOST=hitrack-db
DB_PORT=5432
DB_USER=hitrack
DB_PASSWORD=hitrack
WORKERS=4

# Local development defaults. For production set DJANGO_DEBUG=false and provide
# DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS and
# CSRF_TRUSTED_ORIGINS through a secret manager or deployment environment.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,hitrack-api

TZ=America/New_York

REDIS_HOST=hitrack-redis
REDIS_PORT=6379

TEMP_ROOT=/var/www/temp
BUILD_DIR=/var/www/build
