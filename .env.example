# Copy only the values you need into your deployment environment. Do not commit
# the resulting secrets file.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=hitrack.example.com
CORS_ALLOWED_ORIGINS=https://hitrack.example.com
CSRF_TRUSTED_ORIGINS=https://hitrack.example.com
SECURE_SSL_REDIRECT=true
TRUST_PROXY_HTTPS_HEADER=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Enable preload only after every subdomain is permanently HTTPS-ready.
SECURE_HSTS_PRELOAD=false

DB_HOST=hitrack-db
DB_PORT=5432
DB_USER=hitrack
DB_PASSWORD=replace-with-a-random-password
REDIS_HOST=hitrack-redis
REDIS_PORT=6379

# Optional one-time bootstrap. Prefer `python manage.py createsuperuser`.
# SUPERUSER_NAME=admin
# SUPERUSER_PSWD=replace-with-a-strong-password
